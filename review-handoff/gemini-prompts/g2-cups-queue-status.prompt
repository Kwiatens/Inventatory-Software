    assert(!parseCupsQueueLine("\treason unknown").has_value());
    assert(!parseCupsQueueLine("").has_value());
    assert(!parseCupsQueueLine("printer ").has_value());
    assert(!parseCupsQueueLine("printer Zebra").has_value());
