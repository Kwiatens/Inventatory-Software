// Linux desktop icons. CMake fills this in from branding/icons/inventatory-<size>.png.
#pragma once

#include <cstddef>

namespace inventatory {

struct EmbeddedIconAsset {
  int size;
  const unsigned char* data;
  size_t length;
};

@INVENTATORY_ICON_ARRAYS@
inline constexpr EmbeddedIconAsset kEmbeddedIconAssets[] = {
@INVENTATORY_ICON_TABLE@};

}  // namespace inventatory
